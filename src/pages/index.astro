---
import 'qrcode-generator';

const site = new URL(Astro.site || 'http://localhost:4321/');
const canonical = site.href;
const title = 'Generador de QR Gratis — Crea y Comparte Códigos QR | QR LIBRE';
const titleEn = 'Free QR Code Generator — Create & Share QR Codes Online | QR LIBRE';
const description =
	'Genera códigos QR gratis al instante. Crea QR para enlaces, url, descárgalos en PNG o compártelos. Rápido, sin registro y en tu navegador. Free online QR code generator.';
const ogImage = new URL('/og.png', site).href;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- ====== SEO BÁSICO ====== -->
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="generador qr, generar codigo qr, crear qr, codigo qr gratis, qr para enlace, qr url, free qr code generator, generate qr code, qr code online, make qr code, scan qr, compartir qr, descargar qr png, qr code creator"
		/>
		<meta name="author" content="QR LIBRE" />
		<meta name="robots" content="index, follow" />
		<meta name="rating" content="general" />
		<meta name="theme-color" content="#07080a" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={canonical} />
		<link rel="alternate" hreflang="en" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />

		<!-- ====== SOCIAL / OPEN GRAPH ====== -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="QR LIBRE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:locale:alternate" content="en_US" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- ====== DATOS ESTRUCTURADOS (Schema.org) ====== -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					name: 'QR LIBRE',
					alternateName: ['Generador de QR Gratis', 'Free QR Code Generator'],
					url: canonical,
					inLanguage: ['es', 'en'],
					description,
					publisher: { '@type': 'Organization', name: 'QR LIBRE' },
				},
				{
					'@type': 'SoftwareApplication',
					name: 'QR LIBRE',
					alternateName: 'Generador de códigos QR / Free QR Code Generator',
					applicationCategory: 'UtilitiesApplication',
					operatingSystem: 'Web',
					url: canonical,
					description,
					inLanguage: ['es', 'en'],
					offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
					featureList: [
						'Generar código QR gratis',
						'Generate free QR code',
						'Descargar QR en PNG',
						'Compartir código QR',
						'QR para enlaces y URL',
					],
				},
			{
					'@type': 'FAQPage',
					mainEntity: [
						{
							'@type': 'Question',
							name: '¿Cómo genero un código QR gratis para un enlace?',
							acceptedAnswer: {
								'@type': 'Answer',
								text: 'Pega la URL en el campo de entrada y QR LIBRE crea el código automáticamente. Elige estilo, color y tamaño, y descárgalo en PNG o compártelo.',
							},
						},
						{
							'@type': 'Question',
							name: '¿Cómo creo un QR code for a link?',
							acceptedAnswer: {
								'@type': 'Answer',
								text: 'Paste your URL into the input box and QR LIBRE generates the code instantly. Choose a style, color, and size, then download the QR as PNG or share it.',
							},
						},
						{
							'@type': 'Question',
							name: '¿El generador de QR es realmente gratuito?',
							acceptedAnswer: {
								'@type': 'Answer',
								text: 'Sí. QR LIBRE genera, descarga y comparte códigos QR sin costo y sin cuenta. Todo se procesa localmente en tu navegador.',
							},
						},
						{
							'@type': 'Question',
							name: '¿Qué tipos de QR puedo crear?',
							acceptedAnswer: {
								'@type': 'Answer',
								text: 'Crea código QR para enlaces, URL, wifi, textos y más, con varios estilos: cuadro, redondo, puntos y diamante.',
							},
						},
						{
							'@type': 'Question',
							name: '¿Cómo descargo o comparto mi código QR?',
							acceptedAnswer: {
								'@type': 'Answer',
								text: 'Usa el botón «Descargar PNG» para guardar el QR como imagen, «Copiar QR» para pegarlo en el portapapeles o «Compartir» para enviarlo desde tu app favorita.',
							},
						},
					],
				},
			],
		})} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<style>
			:root {
				--bg: #07080a;
				--panel: #0e1013;
				--panel-2: #12151a;
				--line: #22262d;
				--ink: #eef1f4;
				--muted: #8b93a1;
				--accent: #d8fe3f;
				--accent-2: #3fe0c8;
				--danger: #ff5d5d;

				--font-display: 'Syne', sans-serif;
				--font-mono: 'IBM Plex Mono', monospace;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html,
			body {
				min-height: 100%;
			}

			body {
				font-family: var(--font-mono);
				background: var(--bg);
				color: var(--ink);
				line-height: 1.5;
				overflow-x: hidden;
			}

			/* Atmospheric grid + glow backdrop */
			.backdrop {
				position: fixed;
				inset: 0;
				z-index: 0;
				pointer-events: none;
				background:
					radial-gradient(60% 55% at 78% -10%, rgba(216, 254, 63, 0.1), transparent 60%),
					radial-gradient(50% 50% at 10% 110%, rgba(63, 224, 200, 0.08), transparent 60%),
					linear-gradient(rgba(34, 38, 45, 0.35) 1px, transparent 1px),
					linear-gradient(90deg, rgba(34, 38, 45, 0.35) 1px, transparent 1px);
				background-size: 100% 100%, 100% 100%, 44px 44px, 44px 44px;
				mask-image: radial-gradient(120% 100% at 50% 0%, #000 30%, transparent 85%);
			}

			.gridscan {
				position: fixed;
				left: 0;
				right: 0;
				height: 2px;
				top: 0;
				z-index: 1;
				pointer-events: none;
				background: linear-gradient(90deg, transparent, rgba(216, 254, 63, 0.6), transparent);
				filter: drop-shadow(0 0 8px var(--accent));
				animation: scan 7s linear infinite;
			}

			@keyframes scan {
				from {
					top: -5%;
					opacity: 0;
				}
				12% {
					opacity: 1;
				}
				88% {
					opacity: 1;
				}
				to {
					top: 105%;
					opacity: 0;
				}
			}

			main {
				position: relative;
				z-index: 2;
				max-width: 1120px;
				margin: 0 auto;
				padding: clamp(2rem, 6vw, 5rem) 1.25rem 4rem;
			}

			/* Top bar */
			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-bottom: 2rem;
				margin-bottom: clamp(2rem, 6vh, 4rem);
				border-bottom: 1px solid var(--line);
				animation: fade 0.7s ease both;
			}

			.brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.brand .mark {
				width: 34px;
				height: 34px;
				display: grid;
				place-items: center;
				border: 1px solid var(--accent);
				color: var(--accent);
				border-radius: 8px;
				font-weight: 800;
				font-size: 0.9rem;
				box-shadow: 0 0 18px rgba(216, 254, 63, 0.25);
			}

			.brand h1 {
				font-family: var(--font-display);
				font-size: 1.15rem;
				font-weight: 800;
				letter-spacing: 0.04em;
			}

			.status {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.7rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.status .dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--accent);
				animation: pulse 1.6s ease-in-out infinite;
			}

			@keyframes pulse {
				0%,
				100% {
					box-shadow: 0 0 0 0 rgba(216, 254, 63, 0.5);
				}
				50% {
					box-shadow: 0 0 0 6px rgba(216, 254, 63, 0);
				}
			}

			@keyframes fade {
				from {
					opacity: 0;
					transform: translateY(14px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			.hero {
				margin-bottom: 3rem;
				animation: fade 0.7s 0.08s ease both;
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.7rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--accent);
				border: 1px solid rgba(216, 254, 63, 0.35);
				background: rgba(216, 254, 63, 0.06);
				padding: 0.4rem 0.8rem;
				border-radius: 999px;
				margin-bottom: 1.25rem;
			}

			.hero h2 {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: clamp(2.2rem, 7vw, 4.6rem);
				line-height: 0.98;
				letter-spacing: -0.02em;
				max-width: 16ch;
			}

			.hero h2 .soft {
				color: var(--muted);
			}

			.hero h2 .inv {
				color: var(--accent);
				text-shadow: 0 0 28px rgba(216, 254, 63, 0.4);
			}

			.hero p {
				margin-top: 1.25rem;
				max-width: 46ch;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.workspace {
				display: grid;
				grid-template-columns: 1.15fr 0.85fr;
				gap: 1.5rem;
				align-items: stretch;
				animation: fade 0.7s 0.16s ease both;
			}

			.panel {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 18px;
				padding: 1.75rem;
				position: relative;
				overflow: hidden;
			}

			.panel::before {
				content: '';
				position: absolute;
				inset: 0 0 auto 0;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--accent), transparent);
				opacity: 0.6;
			}

			.panel-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.5rem;
			}

			.panel-head h3 {
				font-family: var(--font-display);
				font-size: 0.9rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.panel-head .hint {
				font-size: 0.68rem;
				color: var(--muted);
				letter-spacing: 0.08em;
			}

			/* Input */
			.field {
				position: relative;
			}

			.field .prefix {
				position: absolute;
				left: 1rem;
				top: 50%;
				transform: translateY(-50%);
				font-size: 0.78rem;
				color: var(--accent);
				letter-spacing: 0.08em;
				pointer-events: none;
			}

			.field input {
				width: 100%;
				background: var(--panel-2);
				border: 1px solid var(--line);
				border-radius: 12px;
				color: var(--ink);
				font-family: var(--font-mono);
				font-size: 0.95rem;
				padding: 1.05rem 1rem 1.05rem 3rem;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.field input:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(216, 254, 63, 0.12);
			}

			.field input::placeholder {
				color: #5a6270;
			}

			.input-err {
				color: var(--danger);
				font-size: 0.72rem;
				margin-top: 0.5rem;
				min-height: 1em;
			}

			/* Options */
			.options {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr;
				gap: 1rem;
				margin: 1.5rem 0;
			}

			.opt label {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				font-size: 0.68rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.opt select,
			.opt input[type='color'] {
				width: 100%;
				background: var(--panel-2);
				border: 1px solid var(--line);
				border-radius: 10px;
				color: var(--ink);
				font-family: var(--font-mono);
				font-size: 0.85rem;
				padding: 0.6rem 0.6rem;
			}

			.opt input[type='color'] {
				height: 42px;
				padding: 4px;
				cursor: pointer;
			}

			/* Segmented toggle for size */
			.seg {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				background: var(--panel-2);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 3px;
			}

			.seg button {
				background: transparent;
				border: none;
				color: var(--muted);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				padding: 0.5rem;
				border-radius: 8px;
				cursor: pointer;
				transition: all 0.15s;
			}

			.seg button.active {
				background: var(--accent);
				color: #0a0b00;
				font-weight: 600;
			}

			/* QR stage */
			.qr-stage {
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				background: var(--panel-2);
				border: 1px dashed var(--line);
				border-radius: 14px;
				padding: 2rem;
				min-height: 340px;
				position: relative;
			}

			.qr-wrap {
				background: #fff;
				position: relative;
				aspect-ratio: 1;
				width: min(100%, 260px);
				display: grid;
				place-items: center;
				transition: width 0.3s ease;
			}

			.qr-wrap canvas,
			.qr-wrap svg {
				width: 100%;
				height: 100%;
				display: block;
			}

			.qr-corners::before,
			.qr-corners::after {
				content: '';
				position: absolute;
				width: 22px;
				height: 22px;
				border: 2px solid var(--accent);
				pointer-events: none;
			}

			.qr-corners::before {
				top: -8px;
				left: -8px;
				border-right: 0;
				border-bottom: 0;
			}

			.qr-corners::after {
				bottom: -8px;
				right: -8px;
				border-left: 0;
				border-top: 0;
			}

			.qr-empty {
				color: var(--muted);
				font-size: 0.85rem;
				text-align: center;
				line-height: 1.6;
				letter-spacing: 0.04em;
			}

			.qr-empty .sm {
				font-size: 2.4rem;
				display: block;
				margin-bottom: 0.75rem;
				opacity: 0.5;
			}

			/* Actions */
			.actions {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				border-radius: 11px;
				padding: 0.85rem 1rem;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				font-weight: 600;
				cursor: pointer;
				border: 1px solid var(--line);
				background: var(--panel-2);
				color: var(--ink);
				transition: all 0.18s;
				text-decoration: none;
				letter-spacing: 0.02em;
			}

			.btn:hover {
				border-color: var(--accent);
				transform: translateY(-1px);
			}

			.btn.primary {
				background: var(--accent);
				color: #0a0b00;
				border-color: var(--accent);
				box-shadow: 0 6px 20px rgba(216, 254, 63, 0.2);
			}

			.btn.primary:hover {
				box-shadow: 0 8px 26px rgba(216, 254, 63, 0.32);
			}

			.btn:disabled {
				opacity: 0.4;
				cursor: not-allowed;
				transform: none;
			}

			/* Toast */
			.toast {
				position: fixed;
				bottom: 1.5rem;
				left: 50%;
				transform: translate(-50%, 130%);
				background: var(--ink);
				color: #0a0b00;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				font-weight: 600;
				padding: 0.8rem 1.4rem;
				border-radius: 999px;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
				z-index: 50;
				transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2);
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.toast.show {
				transform: translate(-50%, 0);
			}

			/* FAQ */
			.faq {
				margin-top: 4rem;
				max-width: 760px;
				animation: fade 0.7s 0.2s ease both;
			}

			.faq h2 {
				font-family: var(--font-display);
				font-size: 1.3rem;
				font-weight: 800;
				margin-bottom: 1.5rem;
				letter-spacing: 0.01em;
			}

			.faq details {
				border: 1px solid var(--line);
				border-radius: 12px;
				background: var(--panel);
				margin-bottom: 0.75rem;
				overflow: hidden;
			}

			.faq summary {
				cursor: pointer;
				list-style: none;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem 1.25rem;
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 0.95rem;
				transition: color 0.2s;
			}

			.faq summary::after {
				content: '+';
				color: var(--accent);
				font-size: 1.3rem;
				transition: transform 0.25s;
				flex-shrink: 0;
			}

			.faq details[open] summary::after {
				transform: rotate(45deg);
			}

			.faq summary:hover {
				color: var(--accent);
			}

			.faq details p {
				padding: 0 1.25rem 1.25rem;
				color: var(--muted);
				font-size: 0.88rem;
			}

			@media (max-width: 480px) {
				.faq h2 {
					font-size: 1.05rem;
				}
			}

			/* Footer */
			footer {
				margin-top: 3.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
				font-size: 0.7rem;
				color: var(--muted);
				letter-spacing: 0.06em;
				animation: fade 0.7s 0.24s ease both;
				position: relative;
				z-index: 2;
			}

			@media (max-width: 820px) {
				.workspace {
					grid-template-columns: 1fr;
				}

				.options {
					grid-template-columns: 1fr 1fr;
				}
			}

			@media (max-width: 480px) {
				.options {
					grid-template-columns: 1fr;
				}
				.status .txt {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<div class="backdrop" aria-hidden="true"></div>
		<div class="gridscan" aria-hidden="true"></div>

		<main>
			<header class="topbar">
				<div class="brand">
					<div class="mark">QR</div>
					<h1>QR LIBRE — Generador de QR Gratis</h1>
				</div>
				<div class="status">
					<span class="dot"></span>
					<span class="txt">Sistema activo · Punto de escaneo 01</span>
				</div>
			</header>

			<section class="hero">
				<span class="eyebrow">Generador de QR gratuito · Free QR generator · Sin registro</span>
				<h2>
					Genera un <span class="inv">código QR</span>
					<br />
					para cualquier <span class="soft">enlace o URL</span>
				</h2>
				<p>
					Crea y comparte códigos QR gratis al instante. Pega una URL, ajusta estilo y
					tamaño, descarga el QR en PNG o compártelo con un toque. Todo en tu navegador,
					sin registro. Generate free QR codes for any link.
				</p>
			</section>

			<section class="workspace">
				<!-- ======= INPUT / CONTROLS ======= -->
				<div class="panel">
					<div class="panel-head">
						<h3>Configuración</h3>
						<span class="hint">ENTRADA → CÓDIGO</span>
					</div>

					<div class="field">
						<span class="prefix">URL</span>
						<input
							id="urlInput"
							type="url"
							inputmode="url"
							placeholder="https://tudominio.com/enlace"
							autocomplete="url"
							spellcheck="false"
						/>
					</div>
					<div id="err" class="input-err" role="alert"></div>

					<div class="options">
						<div class="opt">
							<label>
								Estilo
								<div class="seg" data-role="style">
									<button data-v="square" class="active">Cuadro</button>
									<button data-v="round">Redondo</button>
									<button data-v="dot">Puntos</button>
									<button data-v="diamond">Diamante</button>
								</div>
							</label>
						</div>

						<div class="opt">
							<label>
								Color
								<input id="colorInput" type="color" value="#0a0b00" />
							</label>
						</div>

						<div class="opt">
							<label>
								Tamaño
								<div class="seg" data-role="size">
									<button data-v="160">S</button>
									<button data-v="240" class="active">M</button>
									<button data-v="320">L</button>
									<button data-v="420">XL</button>
								</div>
							</label>
						</div>
					</div>
				</div>

				<!-- ======= QR OUTPUT ======= -->
				<div class="panel">
					<div class="panel-head">
						<h3>Resultado</h3>
						<span id="charCount" class="hint">0 caracteres</span>
					</div>

					<div
						id="stage"
						class="qr-stage"
						data-size="240"
						data-style="square"
						data-color="#0a0b00"
					>
						<div id="qrWrap" class="qr-wrap qr-corners" hidden></div>
						<div id="qrEmpty" class="qr-empty">
							<span class="sm">▚</span>
							El código aparecerá aquí
							<br />
							cuando pegues un enlace.
						</div>
					</div>

					<div class="actions">
						<button id="download" class="btn" disabled>⬇ Descargar PNG</button>
						<button id="downloadTransparent" class="btn" disabled>
							⬇ PNG sin fondo
						</button>
						<button id="share" class="btn" disabled>⇪ Compartir</button>
						<button id="copyQr" class="btn" disabled>
							⧉ Copiar QR al portapapeles
						</button>
					</div>
				</div>
			</section>

			<section class="faq">
				<h2>Preguntas frecuentes · Free QR generator FAQ</h2>

				<details>
					<summary>¿Cómo genero un código QR gratis para un enlace?</summary>
					<p>
						Pega la URL en el campo de entrada y QR LIBRE crea el código automáticamente.
						Puedes elegir estilo, color y tamaño, y luego descargarlo en PNG o compartirlo.
					</p>
				</details>

				<details>
					<summary>¿Cómo creo un QR code for a link in English?</summary>
					<p>
						Paste your URL into the input box and QR LIBRE generates the code instantly.
						Choose a style, color, and size, then download the QR as PNG or share it.
					</p>
				</details>

				<details>
					<summary>¿El generador de QR es realmente gratuito?</summary>
					<p>
						Sí. QR LIBRE genera, descarga y comparte códigos QR sin costo y sin necesidad
						de crear una cuenta. Todo se procesa localmente en tu navegador.
					</p>
				</details>

				<details>
					<summary>¿Qué tipos de QR puedo crear?</summary>
					<p>
						Puedes crear código QR para enlaces, URL, wifi, textos y compartir desde tu
						dispositivo con varios estilos: cuadro, redondo, puntos y diamante.
					</p>
				</details>

				<details>
					<summary>¿Cómo descargo o comparto mi código QR?</summary>
					<p>
						Usa «Descargar PNG» para guardar el QR con fondo blanco o «PNG sin fondo» para
						guardarlo transparente. También puedes copiarlo al portapapeles o compartirlo.
					</p>
				</details>
			</section>

			<footer>
				<span>QR LIBRE © 2026 · Hecho para abrir enlaces desde cualquier pantalla.</span>
				<span>Generado al instante en tu navegador.</span>
			</footer>
		</main>

		<div id="toast" class="toast" role="status"></div>

		<script>
			import qrcode from 'qrcode-generator';

			const urlEl = document.getElementById('urlInput');
			const errEl = document.getElementById('err');
			const countEl = document.getElementById('charCount');
			const stage = document.getElementById('stage');
			const wrap = document.getElementById('qrWrap');
			const empty = document.getElementById('qrEmpty');
			const colEl = document.getElementById('colorInput');
			const downloadBtn = document.getElementById('download');
			const downloadTransparentBtn = document.getElementById('downloadTransparent');
			const shareBtn = document.getElementById('share');
			const copyBtn = document.getElementById('copyQr');
			const toast = document.getElementById('toast');

			let state = { size: 240, style: 'square', color: '#0a0b00' };
			let debounceTimer = null;

			const urlPattern = /^(https?:\/\/)/i;

			function showToast(msg) {
				toast.textContent = '✓ ' + msg;
				toast.classList.add('show');
				clearTimeout(showToast._t);
				showToast._t = setTimeout(() => toast.classList.remove('show'), 2200);
			}

			function normalizeUrl(raw) {
				const v = raw.trim();
				if (!v) return { value: '' };
				const withProto = urlPattern.test(v) ? v : 'https://' + v;
				try {
					const u = new URL(withProto);
					return { value: u.href };
				} catch {
					return { value: null };
				}
			}

			function render() {
				const raw = urlEl.value;
				if (!raw.trim()) {
					errEl.textContent = '';
					countEl.textContent = '0 caracteres';
					wrap.hidden = true;
					empty.hidden = false;
					downloadBtn.disabled = true;
					downloadTransparentBtn.disabled = true;
					shareBtn.disabled = true;
					copyBtn.disabled = true;
					return;
				}
				countEl.textContent = raw.trim().length + ' caracteres';

				const { value } = normalizeUrl(raw);
				if (!value) {
					errEl.textContent = '⚠ Ingresa una URL válida, ej: https://ejemplo.com';
					downloadBtn.disabled = true;
					downloadTransparentBtn.disabled = true;
					shareBtn.disabled = true;
					copyBtn.disabled = true;
					return;
				}
				errEl.textContent = '';
				stage.dataset.size = state.size;
				stage.dataset.style = state.style;
				stage.dataset.color = state.color;

				draw(value);

				downloadBtn.disabled = false;
				downloadTransparentBtn.disabled = false;
				shareBtn.disabled = false;
				copyBtn.disabled = false;
			}

			function scaledSize() {
				let s = state.size;
				if (s >= 200) s = Math.max(s, 320);
				return s;
			}

			function draw(text) {
				const qr = createQr(text);
				const size = scaledSize();
				wrap.hidden = false;
				empty.hidden = true;
				wrap.style.width = Math.min(size, 300) + 'px';
				wrap.innerHTML = '';

				wrap.appendChild(renderQr(qr, size));
			}

			function createQr(text) {
				const qr = qrcode(0, 'M');
				qr.addData(text);
				qr.make();
				return qr;
			}

			function renderQr(qr, size, transparent = false) {
				const canvas = document.createElement('canvas');
				canvas.width = size;
				canvas.height = size;
				const ctx = canvas.getContext('2d');
				const count = qr.getModuleCount();
				// Quiet zone obligatoria: 4 módulos de margen blanco a cada lado.
				// Se descuenta del tamaño de celda para que el código ESTÉ dentro del lienzo.
				const quiet = 4;
				const totalCells = count + quiet * 2;
				const cell = size / totalCells;
				const origin = quiet * cell;
				const color = state.color;
				if (!transparent) {
					ctx.fillStyle = '#ffffff';
					ctx.fillRect(0, 0, size, size);
				}

				for (let r = 0; r < count; r++) {
					for (let c = 0; c < count; c++) {
						if (!qr.isDark(r, c)) continue;
						const x = origin + c * cell;
						const y = origin + r * cell;
						const s = cell;
						if (state.style === 'diamond') {
							ctx.save();
							ctx.translate(x + s / 2, y + s / 2);
							ctx.rotate(Math.PI / 4);
							const half = s * 0.5 * 1.05;
							ctx.fillStyle = color;
							ctx.fillRect(-half / 2, -half / 2, half, half);
							ctx.restore();
						} else {
							ctx.fillStyle = color;
							const radius =
								state.style === 'round' || state.style === 'dot'
									? s * (state.style === 'dot' ? 0.52 : 0.44)
									: 0;
							roundRect(ctx, x, y, s, s, radius);
							ctx.fill();
						}
					}
				}

				return canvas;
			}

			function roundRect(ctx, x, y, w, h, r) {
				r = Math.min(r, w / 2, h / 2);
				ctx.beginPath();
				ctx.moveTo(x + r, y);
				ctx.arcTo(x + w, y, x + w, y + h, r);
				ctx.arcTo(x + w, y + h, x, y + h, r);
				ctx.arcTo(x, y + h, x, y, r);
				ctx.arcTo(x, y, x + w, y, r);
				ctx.closePath();
			}

			function getCanvas() {
				return wrap.querySelector('canvas');
			}

			function downloadPng(transparent = false) {
				const { value } = normalizeUrl(urlEl.value);
				if (!value) return;
				const canvas = renderQr(createQr(value), scaledSize(), transparent);
				const a = document.createElement('a');
				a.download = transparent ? 'qr-libre-transparente.png' : 'qr-libre.png';
				a.href = canvas.toDataURL('image/png');
				a.click();
				showToast(transparent ? 'PNG transparente descargado' : 'PNG descargado');
			}

			function getValidatedUrl() {
				const { value } = normalizeUrl(urlEl.value);
				if (!value) {
					errEl.textContent = '⚠ Ingresa una URL válida para compartir.';
					return null;
				}
				return value;
			}

			function copyPngToClipboard() {
				const canvas = getCanvas();
				if (!canvas) return;
				canvas.toBlob(async (blob) => {
					if (!blob) return;
					try {
						await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
						showToast('QR copiado al portapapeles');
					} catch {
						downloadPng();
					}
				});
			}

			async function shareUrl() {
				const value = getValidatedUrl();
				if (!value) return;
				const canvas = getCanvas();

				try {
					const files = canvas
						? [new File([await toBlob(canvas)], 'qr-libre.png', { type: 'image/png' })]
						: [];
					if (navigator.share) {
						await navigator.share({
							title: 'Mi código QR',
							text: 'Escanea este código o abre el enlace:',
							url: value,
							files,
						});
						showToast('Compartido');
					} else {
						await navigator.clipboard.writeText(value);
						showToast('Enlace copiado');
					}
				} catch (e) {
					if (e.name === 'AbortError') return;
					try {
						await navigator.clipboard.writeText(value);
						showToast('Enlace copiado');
					} catch {
						/* noop */
					}
				}
			}

			function toBlob(canvas) {
				return new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('blob')))));
			}

			// ---- Wiring ----
			urlEl.addEventListener('input', () => {
				clearTimeout(debounceTimer);
				debounceTimer = setTimeout(render, 60);
			});

			colEl.addEventListener('input', () => {
				state.color = colEl.value;
				render();
			});

			document.querySelectorAll('[data-role="style"] button').forEach((btn) => {
				btn.addEventListener('click', () => {
					document
						.querySelectorAll('[data-role="style"] button')
						.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					state.style = btn.dataset.v;
					render();
				});
			});

			document.querySelectorAll('[data-role="size"] button').forEach((btn) => {
				btn.addEventListener('click', () => {
					document
						.querySelectorAll('[data-role="size"] button')
						.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					state.size = parseInt(btn.dataset.v, 10);
					render();
				});
			});

			downloadBtn.addEventListener('click', downloadPng);
			downloadTransparentBtn.addEventListener('click', () => downloadPng(true));
			copyBtn.addEventListener('click', copyPngToClipboard);
			shareBtn.addEventListener('click', shareUrl);

			urlEl.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					e.preventDefault();
					render();
				}
			});
		</script>
	</body>
</html>
